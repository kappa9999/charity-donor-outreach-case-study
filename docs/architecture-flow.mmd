flowchart TB
  A["1. Untrusted inputs<br/>Campaign JSON + donor JSONL"] --> B["2. Validate inputs<br/>Strict JSON, schemas, and resource ceilings"]
  B -->|valid| C["3. Decide policy<br/>Permission, cadence, ask, facts, and review"]
  B -->|invalid| X["invalid<br/>No provider call"]
  C -->|eligible| D["4. Minimize context<br/>Approved drafting fields only"]
  C -->|blocked or suppressed| Y["Structured stop<br/>No provider call"]
  D --> E["5. Draft provider<br/>Isolated, replaceable prose boundary"]
  E -->|candidate| F["6. Guard + result<br/>Validate structure, claims, and provenance"]
  E -->|exception| Z["provider_error<br/>Continue batch"]
  F -->|fail| Q["quality_rejected<br/>Draft withheld"]
  F -->|pass| G["draft_ready or review_required"]
  G --> H["Human approval + delivery<br/>Outside this repository"]

  classDef control fill:#eff6ff,stroke:#2563eb,color:#0f172a,stroke-width:2px;
  classDef provider fill:#f5f3ff,stroke:#6d28d9,color:#0f172a,stroke-width:2px,stroke-dasharray:6 4;
  classDef stop fill:#fff7ed,stroke:#c2410c,color:#7c2d12,stroke-width:2px;
  classDef external fill:#0f172a,stroke:#0f172a,color:#ffffff,stroke-width:2px;
  class A,B,C,D,F,G control;
  class E provider;
  class X,Y,Z,Q stop;
  class H external;
